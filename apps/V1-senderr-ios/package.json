{
  "name": "v1-senderr-ios",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios --scheme Senderr",
    "ios:device": "bash scripts/ios-device-deploy.sh",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "test:unit": "jest --config jest.config.js src/screens/__tests__",
    "test:integration": "jest --config jest.integration.config.js src/services/__integration__/jobs.emulator.integration.test.ts",
    "detox:build": "detox build -c ios.sim.debug",
    "detox:test": "detox test -c ios.sim.debug"
  },
  "dependencies": {
    "@gosenderr/contracts": "workspace:*",
    "@babel/runtime": "^7.25.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-firebase/analytics": "^21.7.1",
    "@react-native-firebase/app": "^21.7.1",
    "@react-native-firebase/crashlytics": "^21.7.1",
    "@react-native-firebase/messaging": "^21.7.1",
    "firebase": "^12.0.0",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-image-picker": "^5.0.1",
    "react-native-maps": "1.18.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native-community/cli-platform-ios": "15.0.1",
    "@react-native/babel-preset": "0.76.5",
    "@react-native/eslint-config": "0.76.5",
    "@react-native/metro-config": "0.76.5",
    "@react-native/typescript-config": "0.76.5",
    "@types/react": "^18.2.6",
    "@types/react-test-renderer": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "babel-jest": "^29.6.3",
    "eslint": "^9.39.2",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "18.3.1",
    "typescript": "5.0.4",
    "detox": "^19.8.0"
  },
  "detox": {
    "test-runner": "jest",
    "configurations": {
      "ios.sim.debug": {
        "type": "ios.simulator",
        "device": {
          "id": "199AC40E-7AFC-458F-BC93-8D833F3BEB44"
        },
        "binaryPath": "ios/build/Build/Products/Debug-iphonesimulator/Senderr.app",
        "build": "xcodebuild -workspace ios/Senderrappios.xcworkspace -scheme Senderr -configuration Debug -sdk iphonesimulator -derivedDataPath ios/build"
      }
    }
  },
  "engines": {
    "node": ">=18"
  }
}
