{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ios-metro",
      "type": "shell",
      "command": "pnpm --filter v1-senderr-ios start",
      "options": {
        "cwd": "${workspaceFolder}/apps/V1-senderr-ios"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*(Welcome to Metro|Starting Metro|== Serving HTTP on|\bStarted\b).*",
          "endsPattern": ".*(waiting on|Metro waiting|ready|All emulators are ready).*"
        }
      },
      "isBackground": true
    },
    {
      "label": "ios-open-xcode",
      "type": "shell",
      "command": "open -a Xcode apps/V1-senderr-ios/ios/Senderrappios.xcworkspace",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "ios-sync-native",
      "type": "shell",
      "command": "pod install",
      "options": {
        "cwd": "${workspaceFolder}/apps/V1-senderr-ios/ios"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "emulators:start",
      "type": "shell",
      "command": "bash scripts/start-emulators.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*(Welcome to Metro|Starting Metro|== Serving HTTP on|\bStarted\b).*",
          "endsPattern": ".*(waiting on|Metro waiting|ready|All emulators are ready).*"
        }
      },
      "isBackground": true
    },
    {
      "label": "emulators:seed",
      "type": "shell",
      "command": "bash -lc 'FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIREBASE_PROJECT_ID=\"${FIREBASE_PROJECT_ID:-gosenderr-6773f}\" SENDERR_FIREBASE_PROJECT_ID=\"${SENDERR_FIREBASE_PROJECT_ID:-gosenderr-6773f}\" ( [ -f ./scripts/seed-role-simulation.js ] && FIREBASE_PROJECT_ID=gosenderr-6773f node ./scripts/seed-role-simulation.js || true ) && ( [ -f ./scripts/seed-courier-emulator.js ] && node ./scripts/seed-courier-emulator.js || true ) && ( [ -f ./scripts/seed-admin-data.ts ] && npx --yes tsx ./scripts/seed-admin-data.ts || true ) && ( [ -f ./scripts/init-feature-flags.ts ] && ENABLE_ADMIN_WEB=1 npx --yes tsx ./scripts/init-feature-flags.ts || true )'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*(Welcome to Metro|Starting Metro|== Serving HTTP on|\bStarted\b).*",
          "endsPattern": ".*(waiting on|Metro waiting|ready|All emulators are ready).*"
        }
      },
      "isBackground": true
    },
    {
      "label": "stop",
      "type": "shell",
      "command": "( pkill -f \"firebase\" || true ) && ( pkill -f \"react-native\" || true ) && ( pkill -f \"pnpm.*dev\" || true ) && ( pkill -f \"node.*vite\" || true ) && lsof -ti:4000,8080,9099,9199,5001,8081,5173,3000 2>/dev/null | xargs -r kill -9 || true && rm -f \"${TMPDIR:-/tmp}/gosenderr-marketplace-seed-ready\" 2>/dev/null || true",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "lint",
      "type": "shell",
      "command": "pnpm lint",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "build",
      "type": "shell",
      "command": "pnpm build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "dev",
      "type": "shell",
      "command": "pnpm dev",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "ios-profile",
      "dependsOn": [
        "ios-open-xcode",
        "ios-metro"
      ],
      "dependsOrder": "parallel",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
